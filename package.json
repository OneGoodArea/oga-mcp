{
  "name": "@oga-mcp/server",
  "version": "1.0.13",
  "mcpName": "com.onegoodarea/oga-mcp",
  "description": "OneGoodArea MCP server. OneGoodArea is the intelligence layer for place: sourced, dated facts, explained scores, change monitoring and typed queries for every neighbourhood in Great Britain, served by one API. This server puts that API inside Claude Desktop, Cursor, Claude Code and any MCP client, every answer composed on the server from the engine.",
  "license": "MIT",
  "homepage": "https://www.onegoodarea.com/docs/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneGoodArea/oga-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/OneGoodArea/oga-mcp/issues"
  },
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "oga-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "eval:typecheck": "tsc -p tsconfig.eval.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@types/node": "^25.7.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "onegoodarea",
    "uk",
    "location-intelligence",
    "property",
    "postcode"
  ]
}
